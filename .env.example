APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Zoho Mail (custom domain) SMTP — see https://www.zoho.com/mail/help/zoho-smtp.html
# Use MAIL_PORT=587 with MAIL_ENCRYPTION=tls, or MAIL_PORT=465 with MAIL_ENCRYPTION=ssl.
# MAIL_USERNAME/MAIL_FROM_ADDRESS should be the full mailbox address on your custom domain
# (e.g. bookings@yourdomain.com); MAIL_PASSWORD is a Zoho app-specific password, not your login password.
MAIL_MAILER=smtp
MAIL_HOST=smtp.zoho.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Meridian Travel"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Moolre (https://docs.moolre.com/) mobile-money payments — sandbox only needs MOOLRE_API_USER.
MOOLRE_BASE_URL=https://sandbox.moolre.com
MOOLRE_API_USER=
MOOLRE_PRIVATE_KEY=
MOOLRE_PUBLIC_KEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_SENDER_ID=
# Public URL Moolre POSTs payment notifications to (must be internet-reachable, e.g. an ngrok
# tunnel in local dev — the app also self-polls Moolre for status so this isn't required to work).
MOOLRE_CALLBACK_URL=
# Where the customer is redirected back to after paying on Moolre's hosted checkout page.
FRONTEND_URL=http://localhost:5173

# SerpApi (https://serpapi.com/) — powers real flight/hotel search in the itinerary builder.
# Called server-side only; never expose this key to the frontend.
SERPAPI_KEY=
